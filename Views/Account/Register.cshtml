@model QL_BANTHUCPHAM.Models.NguoiDung

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center text-success">ĐĂNG KÝ TÀI KHOẢN</h2>
    
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Register" method="post">
        <div class="mb-3">
            <label class="form-label">Tên đăng nhập</label>
            <input asp-for="HoTen" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Mật khẩu</label>
            <input asp-for="MatKhauMaHoa" type="password" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Họ và tên</label>
            <input asp-for="HoTen" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
    </form>
</div>