@model IEnumerable<QL_BANTHUCPHAM.Controllers.CartItemViewModel>

<div class="container my-5">
    <h2 class="text-success fw-bold mb-4">🛒 Giỏ hàng của bạn</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">Giỏ hàng của bạn đang trống. Hãy tiếp tục mua sắm nhé!</div>
        <a href="/SanPham" class="btn btn-primary">Quay lại mua sắm</a>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Hình ảnh</th>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    // Gán id="row-@item.MaSanPham" để JS tìm thấy và xóa
                    <tr id="row-@item.MaSanPham">
                        <td><img src="~/Images/@item.HinhAnh" width="60" class="rounded" /></td>
                        <td>@item.TenSanPham</td>
                        <td>@item.GiaBan.ToString("#,##0") đ</td>
                        <td>
                            <input type="text" class="qty-input" value="@item.SoLuong" readonly style="width: 40px; text-align: center;">
                        </td>
                        <td class="fw-bold text-danger">@item.ThanhTien.ToString("#,##0") đ</td>
                        <td>
                            <button class="btn btn-sm btn-warning" onclick="updateCart(@item.MaSanPham, -1, 'row-@item.MaSanPham')">-</button>
                            <button class="btn btn-sm btn-danger" onclick="updateCart(@item.MaSanPham, -99, 'row-@item.MaSanPham')">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <div class="text-end mt-4">
            <h4>Tổng cộng: <span class="text-danger fw-bold">@Model.Sum(x => x.ThanhTien).ToString("#,##0") đ</span></h4>
            <a href="/ThanhToan/Index" class="btn btn-success btn-lg px-5">Tiến hành thanh toán</a>
        </div>
    }
</div>

<script>
    function updateCart(maSanPham, delta, rowId) {
        fetch('/GioHang/UpdateCart', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.getElementsByName("__RequestVerificationToken")?.length > 0 ? document.getElementsByName("__RequestVerificationToken")[0].value : ""
            },
            body: `maSanPham=${maSanPham}&delta=${delta}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // 1. Cập nhật icon giỏ hàng trên navbar
                const cartCount = document.getElementById('cart-count');
                if(cartCount) cartCount.innerText = data.totalItems;
                
                // 2. Xử lý xóa hoặc giảm số lượng
                let row = document.getElementById(rowId);
                if (delta === -99 || parseInt(row.querySelector('.qty-input').value) + delta <= 0) {
                    row.remove(); // Xóa khỏi bảng
                } else {
                    let qtyInput = row.querySelector('.qty-input');
                    qtyInput.value = parseInt(qtyInput.value) + delta;
                }
                
                // 3. (Tùy chọn) Reload trang hoặc dùng JS tính lại tổng tiền để tránh sai sót
                location.reload(); 
            }
        });
    }
</script>
