@model IEnumerable<QL_BANTHUCPHAM.Controllers.CartItemViewModel>

<div class="container my-5">
    <h2 class="text-success fw-bold mb-4">🛒 Giỏ hàng của bạn</h2>
    <div id="cart-content-area" style="min-height: 400px;">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">Giỏ hàng của bạn đang trống. Hãy tiếp tục mua sắm nhé!</div>
            <a href="/SanPham" class="btn btn-primary">Quay lại mua sắm</a>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                        <th>Thao tác số lượng</th>
                        <th>Đơn vị</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Gán id="row-@item.MaSanPham" để JS tìm thấy và xóa
                        <tr id="row-@item.MaSanPham" data-price="@item.GiaBan" data-qty="@item.SoLuong">

                            <td><img src="~/Images/@item.HinhAnh" width="60" class="rounded" /></td>
                            <td>@item.TenSanPham</td>
                            <td>@item.GiaBan.ToString("#,##0") đ</td>
                            <td class="price-item fw-bold text-danger">@item.ThanhTien.ToString("#,##0") đ</td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <button class="btn btn-sm btn-outline-secondary px-2 py-1" 
                                            onclick="updateCart(@item.MaSanPham, -1, 'row-@item.MaSanPham')">−</button>
                                    
                                    <input type="number" class="qty-input text-center border rounded" 
                                        value="@item.SoLuong" min = "1"
                                        style="width: 42px; height: 32px;"
                                        onchange="updateCartManual(@item.MaSanPham, this, 'row-@item.MaSanPham')">
                                    
                                    <button class="btn btn-sm btn-outline-secondary px-2 py-1" 
                                            onclick="updateCart(@item.MaSanPham, 1, 'row-@item.MaSanPham')">+</button>
                                </div>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-danger" onclick="updateCart(@item.MaSanPham, -99, 'row-@item.MaSanPham')">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                            <td>
                                
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            <div class="text-end mt-4">
                <h4>Tổng cộng: 
                    <span id="grand-total" class="text-danger fw-bold">
                        @Model.Sum(x => x.ThanhTien).ToString("#,##0") đ
                    </span>
                </h4>
                <a href="/ThanhToan/Index" class="btn btn-success btn-lg px-5">Tiến hành thanh toán</a>
            </div>
        }
    </div>
</div>
<div id="toast-container"></div>
<script>
    // Hàm tạo và hiển thị thông báo
    function showToast(message) {
        const container = document.getElementById('toast-container');
        container.innerHTML = ''; // Xóa thông báo cũ
        
        const toast = document.createElement('div');
        toast.className = 'toast-message';
        toast.innerText = message;
        
        container.appendChild(toast);
        
        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    // Hàm cập nhật giỏ hàng chính
    function updateCart(maSanPham, delta, rowId) {
        fetch('/GioHang/UpdateCart', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.getElementsByName("__RequestVerificationToken")?.length > 0 ? document.getElementsByName("__RequestVerificationToken")[0].value : ""
            },
            body: `maSanPham=${maSanPham}&delta=${delta}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                $('.cart-count').text(data.totalItems);
                
                let row = document.getElementById(rowId);
                let qtyInput = row.querySelector('.qty-input');
                let newQty = parseInt(qtyInput.value) + delta;
                
                if (delta === -99 || newQty <= 0) {
                    row.remove(); 
                } else {
                    qtyInput.value = newQty;
                    let price = parseFloat(row.getAttribute('data-price'));
                    row.querySelector('.price-item').innerText = (newQty * price).toLocaleString('vi-VN') + ' đ';
                }
                
                // Hiển thị thông báo khi cập nhật thành công
                showToast("Cập nhật giỏ hàng thành công!");
                
                // Gọi hàm tính toán tổng tiền
                calculateTotal(); 
            }
        });
    }

    function calculateTotal() {
        let grandTotal = 0;
        let rows = document.querySelectorAll('tbody tr');
        
        if (rows.length === 0) {
            let area = document.getElementById('cart-content-area');
            // Kiểm tra để tránh thêm thông báo trùng lặp nhiều lần
            if (!document.getElementById('empty-msg')) {
                document.querySelector('table').style.display = 'none';
                document.querySelector('.text-end').style.display = 'none';
                area.innerHTML = `
                    <div id="empty-msg" class="alert alert-info">Giỏ hàng của bạn đang trống!</div>
                    <a href="/SanPham" class="btn btn-primary">Quay lại mua sắm</a>
                `;
            }
            return;
        }

        rows.forEach(row => {
            let qty = parseInt(row.querySelector('.qty-input').value) || 0;
            let price = parseFloat(row.getAttribute('data-price')) || 0;
            grandTotal += (qty * price);
        });
        
        document.getElementById('grand-total').innerText = grandTotal.toLocaleString('vi-VN') + ' đ';
    }
    function updateCartManual(maSanPham, input, rowId) {
        let newQty = parseInt(input.value);
        
        // Nếu nhập số không hợp lệ hoặc <= 0 thì reset về 1
        if (isNaN(newQty) || newQty <= 0) {
            input.value = 1;
            newQty = 1;
        }

        let row = document.getElementById(rowId);
        let oldQty = parseInt(row.getAttribute('data-qty') || 1);
        let delta = newQty - oldQty; // Tính chênh lệch để gửi lên server

        if (delta === 0) return; // Không thay đổi thì thôi

        fetch('/GioHang/UpdateCart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `maSanPham=${maSanPham}&delta=${delta}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                $('.cart-count').text(data.totalItems);
                row.setAttribute('data-qty', newQty); // Cập nhật lại data-qty
                let price = parseFloat(row.getAttribute('data-price'));
                row.querySelector('.price-item').innerText = (newQty * price).toLocaleString('vi-VN') + ' đ';
                calculateTotal();
                showToast("Cập nhật giỏ hàng thành công!");
            }
        });
    }
</script>
